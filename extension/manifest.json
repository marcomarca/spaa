{
  "manifest_version": 3,
  "name": "SPAA Gemini AI Studio TTS Worker",
  "version": "1.0.0",
  "description": "Worker automatizado supervisado para síntesis TTS en Gemini AI Studio.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["src/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SPAA Worker Status",
    "default_popup": "src/popup/popup.html"
  }
}
