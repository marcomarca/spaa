{
  "manifest_version": 3,
  "name": "SPAA Gemini AI Studio TTS Worker",
  "version": "3.3.0",
  "description": "Worker automatizado supervisado para síntesis TTS en Gemini AI Studio.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://aistudio.google.com/*",
    "https://aistudio.google.com/*",
    "https://*.google.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "src/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://*.aistudio.google.com/*",
        "*://aistudio.google.com/*"
      ],
      "js": ["src/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SPAA Worker Status",
    "default_popup": "src/popup/popup.html"
  }
}
