# SPAA Master Server Configuration
SPAA_ENVIRONMENT=development
SPAA_HOST=0.0.0.0
SPAA_PORT=8000

# Audio Encoding (Mono 96 kbps @ 44.1 kHz recommended for voice)
SPAA_MP3_BITRATE_KBPS=96
SPAA_MP3_SAMPLE_RATE_HZ=44100
SPAA_MP3_CHANNELS=1

# Segmentation Parameters
SPAA_MAX_CHUNK_WORDS=950
SPAA_TARGET_CHUNK_WORDS=850

# TTS Queue Leases & Retries
SPAA_LEASE_DURATION_SECONDS=300
SPAA_HEARTBEAT_INTERVAL_SECONDS=30
SPAA_RETRY_DELAY_1_SECONDS=300
SPAA_RETRY_DELAY_2_SECONDS=1800
SPAA_MAX_RETRIES_BEFORE_WAITING=3

# Optional Custom Database Path (defaults to data/spaa_master.sqlite)
# SPAA_SQLITE_DB_PATH=/path/to/custom.sqlite
